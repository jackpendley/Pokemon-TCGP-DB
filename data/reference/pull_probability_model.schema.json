{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pokemon TCG Pocket Pull Probability Model",
  "description": "Per-pack pull probability model for PTCGP. rarity_probabilities are null until populated from verified in-app offering rates. slot_rates may be populated from trusted external sources with confidence=inferred.",
  "type": "object",
  "required": ["meta", "packs"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["generated_at", "model_version", "source_status"],
      "properties": {
        "generated_at": { "type": "string" },
        "model_version": { "type": "string" },
        "source_status": {
          "type": "string",
          "enum": ["verified", "inferred", "scaffold_only"]
        },
        "verified_source": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] }
      }
    },
    "packs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pack_name", "expansion", "set_code", "confidence", "rarity_probabilities"],
        "properties": {
          "pack_name": { "type": "string" },
          "expansion": { "type": "string" },
          "set_code": { "type": "string" },
          "is_shared_pool": {
            "type": "boolean",
            "description": "True if this represents the shared pool of an expansion, not a directly pullable pack"
          },
          "source_url": { "type": ["string", "null"] },
          "source_name": { "type": ["string", "null"] },
          "source_accessed_at": { "type": ["string", "null"] },
          "confidence": {
            "type": "string",
            "enum": ["verified", "inferred", "unknown"]
          },
          "slot_model": {
            "type": ["object", "null"],
            "properties": {
              "cards_per_pack": { "type": ["integer", "null"] },
              "slot_count": { "type": ["integer", "null"] },
              "notes": { "type": ["string", "null"] }
            }
          },
          "slot_rates": {
            "type": ["object", "null"],
            "description": "Per-slot pull probability tables. Populated from trusted external sources (confidence=inferred) or in-app Offering Rates (confidence=verified). Slots 1-3 are always one_diamond in regular packs. Slot 4 and slot 5 have different rarity distributions. Rare/god packs apply one distribution across all 5 slots.",
            "properties": {
              "regular_pack_probability": {
                "type": ["number", "null"],
                "minimum": 0, "maximum": 1,
                "description": "Probability that a given pack opening is a regular (non-rare) pack"
              },
              "rare_pack_probability": {
                "type": ["number", "null"],
                "minimum": 0, "maximum": 1,
                "description": "Probability that a given pack opening is a rare/god pack"
              },
              "slots_1_3": {
                "type": ["object", "null"],
                "description": "Rarity distribution for slots 1, 2, and 3 in a regular pack (always one_diamond)"
              },
              "slot_4": {
                "type": ["object", "null"],
                "description": "Rarity distribution for slot 4 in a regular pack (guaranteed 2-diamond or better)"
              },
              "slot_5": {
                "type": ["object", "null"],
                "description": "Rarity distribution for slot 5 in a regular pack (the rare slot, never below 2-diamond)"
              },
              "rare_pack_all_5_slots": {
                "type": ["object", "null"],
                "description": "Rarity distribution applied uniformly to all 5 slots in a rare/god pack"
              },
              "confidence": {
                "type": ["string", "null"],
                "enum": ["verified", "inferred", "unknown", null]
              },
              "source_name": { "type": ["string", "null"] },
              "source_url": { "type": ["string", "null"] },
              "source_accessed_at": { "type": ["string", "null"] },
              "source_notes": { "type": ["string", "null"] }
            }
          },
          "card_pool": {
            "type": "object",
            "description": "Card counts by rarity in this pack's pullable pool (pack-specific + shared pool combined).",
            "properties": {
              "pack_specific_total": { "type": "integer" },
              "shared_pool_total": { "type": "integer" },
              "combined_total": { "type": "integer" },
              "pack_specific_by_rarity": { "type": "object" },
              "shared_pool_by_rarity": { "type": "object" },
              "combined_by_rarity": { "type": "object" }
            }
          },
          "rarity_probabilities": {
            "type": "object",
            "description": "Aggregate per-pack pull probability per rarity tier (P(at least one of this rarity in a 5-card pack)). All values null until populated from verified in-app offering rates or computed from slot_rates.",
            "properties": {
              "one_diamond":   { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
              "two_diamond":   { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
              "three_diamond": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
              "four_diamond":  { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
              "one_star":      { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
              "double_star":   { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
              "triple_star":   { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
              "crown":         { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
              "promo":         { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
              "unknown":       { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
            }
          },
          "notes": { "type": ["string", "null"] }
        }
      }
    }
  }
}
