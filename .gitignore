__pycache__/
*.pyc
.DS_Store
.venv/
venv/
env/
.env
Archive.zip
*.zip
screenshots/
crops/
*.log
.claude/

# Automated pipeline — generated images (not tracked)
review/contact_sheets/
ocr_temp/

# Raw reference downloads (unprocessed source data)
data/reference/*.raw.json

# Downloaded card images from reference builder
data/reference/images/

# External reference HTML cache (scraped pages, not tracked)
data/reference/external/html_cache/
# Scrape process log (ephemeral)
data/reference/external/scrape_log.txt

# Pokemon Zone sync — browser session, raw API response, stored auth, HAR exports
.browser_session/
data/sync/last_sync_raw.json
data/sync/.auth.json
*.har

# Runtime sync caches / fetched state — re-fetched on every sync, only timestamps
# churn otherwise; no version-control value (siblings of last_sync_raw above).
data/sync/api_discovery_cache.json
data/sync/player_stats.json
data/sync/sync_review_queue.json
data/sync/last_sync_delta.json
data/sync/sync_history.json

# Generated pipeline outputs — regenerated deterministically on every run from
# collection.json + data/reference/* (the tracked source of truth). Treated as build
# artifacts so a sync that finds no new cards leaves the tree clean. View them by
# running the pipeline; the scripts mkdir these dirs on first run.
data/current/
data/exports/
review/
